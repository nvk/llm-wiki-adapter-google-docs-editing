{
  "manifest_version": 3,
  "name": "LLM Wiki Google Docs Suggestions",
  "description": "Automatically apply explicitly approved llm-wiki plans as suggestions in their exact open Google Doc.",
  "version": "0.7.7",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "debugger",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://docs.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["poller.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LLM Wiki Google Docs Suggestions"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
