{
  "manifest_version": 3,
  "name": "LLM Wiki Google Docs Suggestions",
  "description": "Automatically open an approved Google Doc and apply revision-locked llm-wiki plans as suggestions.",
  "version": "0.8.5",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://docs.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "LLM Wiki Google Docs Suggestions"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
