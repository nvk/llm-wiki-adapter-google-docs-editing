{
  "manifest_version": 3,
  "name": "LLM Wiki Google Docs Suggestions",
  "description": "Apply explicitly approved llm-wiki plans as Google Docs suggestions in the active document.",
  "version": "0.6.1",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "debugger",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://docs.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "LLM Wiki Google Docs Suggestions"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
