{
  "protocol": "llm-wiki-adapter/v1",
  "id": "google-docs-editing",
  "version": "0.10.0",
  "description": "Edit Google Docs with native tracked suggestions through the Docs API, with the shared browser executor retained as a legacy fallback.",
  "distribution": "public",
  "entrypoint": [".venv/bin/python", "adapter.py"],
  "capabilities": [
    "google-docs-browser-inspection",
    "google-docs-bounded-document-scan",
    "google-docs-active-tab-collaboration",
    "google-docs-multi-tab-exact-document-selection",
    "google-docs-browser-revision-lock",
    "google-docs-content-revision-lock",
    "google-docs-suggestion-planning",
    "google-docs-append-suggestions",
    "google-docs-shared-browser-executor",
    "google-docs-shared-executor-runtime-bootstrap",
    "google-docs-tracked-changes",
    "google-docs-browser-readback-verification",
    "google-docs-api-developer-preview-canary",
    "google-docs-api-native-suggest-mode",
    "google-docs-api-required-revision-lock",
    "google-docs-api-suggestion-id-verification"
  ],
  "routes": [
    {
      "id": "edit-google-document",
      "intents": [
        "edit", "revise", "update", "proofread", "replace", "suggest",
        "inspect", "read", "review"
      ],
      "resource": {
        "kind": "url",
        "schemes": ["https"],
        "hosts": ["docs.google.com"],
        "path_prefixes": ["/document/d/"]
      },
      "guide": "AGENT_WORKFLOW.md",
      "priority": 100
    }
  ],
  "network": "optional",
  "writes_wiki": false,
  "operations": {
    "self-test": {
      "read_arguments": [],
      "requires_output_dir": false
    },
    "inspect": {
      "read_arguments": [],
      "remote_resource_arguments": ["collaboration_resource"],
      "requires_output_dir": true,
      "effects": ["remote-read"]
    },
    "plan": {
      "read_arguments": ["edit_spec"],
      "remote_resource_arguments": ["collaboration_resource"],
      "requires_output_dir": true,
      "effects": ["remote-read"]
    },
    "apply": {
      "read_arguments": ["plan"],
      "remote_resource_arguments": ["collaboration_resource"],
      "requires_output_dir": true,
      "approved_plan_argument": "plan",
      "effects": ["remote-read", "remote-write"]
    },
    "recover": {
      "read_arguments": ["plan"],
      "remote_resource_arguments": ["collaboration_resource"],
      "requires_output_dir": true,
      "approved_plan_argument": "plan",
      "effects": ["remote-read", "remote-write"]
    },
    "verify": {
      "read_arguments": ["receipt", "plan"],
      "remote_resource_arguments": ["collaboration_resource"],
      "requires_output_dir": true,
      "effects": ["remote-read"]
    },
    "api-inspect": {
      "read_arguments": [],
      "remote_resource_arguments": ["api_resource"],
      "requires_output_dir": true,
      "effects": ["remote-read"]
    },
    "api-plan": {
      "read_arguments": ["edit_spec"],
      "remote_resource_arguments": ["api_resource"],
      "requires_output_dir": true,
      "effects": ["remote-read"]
    },
    "api-apply": {
      "read_arguments": ["plan"],
      "remote_resource_arguments": ["api_resource"],
      "requires_output_dir": true,
      "approved_plan_argument": "plan",
      "effects": ["remote-read", "remote-write"]
    },
    "api-recover": {
      "read_arguments": ["plan"],
      "remote_resource_arguments": ["api_resource"],
      "requires_output_dir": true,
      "approved_plan_argument": "plan",
      "effects": ["remote-read", "remote-write"]
    },
    "api-verify": {
      "read_arguments": ["receipt", "plan"],
      "remote_resource_arguments": ["api_resource"],
      "requires_output_dir": true,
      "effects": ["remote-read"]
    }
  },
  "output_classes": ["private"]
}
