{
  "protocol": "llm-wiki-adapter/v1",
  "id": "google-docs-editing",
  "version": "0.15.0",
  "description": "Edit explicitly selected Google Docs through the API with OAuth-backed native suggestions and Google Picker per-file access.",
  "distribution": "public",
  "entrypoint": [".venv/bin/python", "adapter.py"],
  "capabilities": [
    "google-docs-api-native-suggestions",
    "google-docs-api-native-suggest-mode",
    "google-docs-api-required-revision-lock",
    "google-docs-api-suggestion-id-verification",
    "google-docs-desktop-oauth-pkce",
    "google-docs-oauth-refresh",
    "google-docs-desktop-picker-file-grant",
    "google-docs-exact-file-oauth-selection",
    "google-docs-no-browser-dependency"
  ],
  "routes": [
    {
      "id": "edit-google-document",
      "intents": [
        "edit", "revise", "update", "proofread", "replace", "suggest",
        "inspect", "read", "review"
      ],
      "resource": {
        "kind": "url",
        "schemes": ["https"],
        "hosts": ["docs.google.com"],
        "path_prefixes": ["/document/d/"]
      },
      "guide": "AGENT_WORKFLOW.md",
      "priority": 100
    }
  ],
  "network": "optional",
  "writes_wiki": false,
  "operations": {
    "self-test": {
      "read_arguments": [],
      "requires_output_dir": false
    },
    "api-inspect": {
      "read_arguments": [],
      "remote_resource_arguments": ["api_resource"],
      "requires_output_dir": true,
      "effects": ["remote-read"]
    },
    "api-plan": {
      "read_arguments": ["edit_spec"],
      "remote_resource_arguments": ["api_resource"],
      "requires_output_dir": true,
      "effects": ["remote-read"]
    },
    "api-apply": {
      "read_arguments": ["plan"],
      "remote_resource_arguments": ["api_resource"],
      "requires_output_dir": true,
      "approved_plan_argument": "plan",
      "effects": ["remote-read", "remote-write"]
    },
    "api-recover": {
      "read_arguments": ["plan"],
      "remote_resource_arguments": ["api_resource"],
      "requires_output_dir": true,
      "approved_plan_argument": "plan",
      "effects": ["remote-read", "remote-write"]
    },
    "api-verify": {
      "read_arguments": ["receipt", "plan"],
      "remote_resource_arguments": ["api_resource"],
      "requires_output_dir": true,
      "effects": ["remote-read"]
    }
  },
  "output_classes": ["private"]
}
